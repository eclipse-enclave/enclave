set -euo pipefail

usage() {
    echo "usage: enclave-install-npm-tool [npm-flag ...] <package> <binary> [label]" >&2
    exit 2
}

npm_flags=()
while [ "$#" -gt 0 ] && [[ "$1" == -* ]]; do
    if [ "$1" = "--" ]; then
        shift
        break
    fi
    npm_flags+=("$1")
    shift
done

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    usage
fi

package="$1"
binary="$2"
label="${3:-$binary}"

enclave-agent-npm-install "${npm_flags[@]}" "$package"

if ! command -v "$binary" >/dev/null 2>&1; then
    echo "$label install failed: $binary binary not found" >&2
    exit 1
fi

printf '%s installed at: %s\n' "$label" "$(command -v "$binary")"
