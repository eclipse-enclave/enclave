{
  "name": "opencode",
  "command": "opencode",
  "continue_args": [
    "--continue"
  ],
  "yolo_flag": "",
  "yolo_enabled": true,
  "config_dir": ".config/opencode",
  "skills_dir": ".config/opencode/skills",
  "state_paths": [
    "storage/",
    "plans/",
    "snapshot/",
    "worktree/",
    "repos/",
    "opencode*.db*",
    "tool-output/",
    "mcp-auth.json",
    "xdg-state/"
  ],
  "settings_file": "opencode-settings.json",
  "settings_target": ".config/opencode/opencode.json",
  "passthrough_paths": [
    "AGENTS.md",
    "agent/",
    "agents/",
    "command/",
    "commands/",
    "config.json",
    "mode/",
    "modes/",
    "opencode.json",
    "opencode.jsonc",
    "plugin/",
    "plugins/",
    "skill/",
    "skills/",
    "tui.json",
    "tui.jsonc"
  ],
  "qemu_store_cache_mmap": true,
  "providers": [
    {
      "name": "openai",
      "credential_secrets": [
        "openai-api-key"
      ],
      "auth_files": [
        "auth.json"
      ],
      "auth_secrets": [
        {
          "file": "auth.json",
          "codec": "provider-map",
          "fields": [
            {
              "pointer": "/openai/key",
              "kind": "apiKey",
              "release": "openai-api-key"
            },
            {
              "pointer": "/anthropic/key",
              "kind": "apiKey",
              "release": "anthropic-api-key"
            },
            {
              "pointer": "/google/key",
              "kind": "apiKey",
              "release": "gemini-api-key"
            },
            {
              "pointer": "/gemini/key",
              "kind": "apiKey",
              "release": "gemini-api-key"
            },
            {
              "pointer": "/openai/access",
              "kind": "access",
              "release": "chatgpt-oauth",
              "placeholder": {
                "shape": "jwt",
                "random": {
                  "encoding": "",
                  "length": 0
                }
              }
            },
            {
              "pointer": "/openai/refresh",
              "kind": "refresh"
            },
            {
              "pointer": "/github-copilot/access",
              "kind": "access",
              "release": "copilot-oauth",
              "placeholder": {
                "prefix": "gho_",
                "random": {
                  "encoding": "alphanumeric",
                  "length": 36
                }
              }
            },
            {
              "pointer": "/github-copilot/refresh",
              "kind": "refresh",
              "placeholder": {
                "prefix": "gho_",
                "random": {
                  "encoding": "alphanumeric",
                  "length": 36
                }
              }
            }
          ]
        }
      ],
      "token_endpoint": {
        "host": "auth.openai.com",
        "path": "/oauth/token",
        "body": "either",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "fields": {
          "access": "access_token",
          "expiresIn": "expires_in",
          "id": "id_token",
          "refresh": "refresh_token",
          "scope": "scope"
        }
      },
      "auth_session": {
        "mode": "",
        "checks": [
          {
            "file": "auth.json",
            "type": "json_pointer_non_null",
            "pointer": "/openai"
          }
        ]
      },
      "oauth_ports": [
        {
          "port": "1455"
        }
      ]
    },
    {
      "name": "anthropic",
      "credential_secrets": [
        "anthropic-api-key"
      ]
    },
    {
      "name": "gemini",
      "credential_secrets": [
        "gemini-api-key"
      ]
    },
    {
      "name": "github-copilot",
      "auth_files": [
        "auth.json"
      ],
      "token_endpoint": {
        "host": "github.com",
        "path": "/login/oauth/access_token",
        "body": "either",
        "grants": [
          "urn:ietf:params:oauth:grant-type:device_code"
        ],
        "fields": {
          "access": "access_token",
          "refresh": "access_token",
          "scope": "scope"
        }
      },
      "auth_session": {
        "mode": "",
        "checks": [
          {
            "file": "auth.json",
            "type": "json_pointer_non_null",
            "pointer": "/github-copilot"
          }
        ]
      }
    },
    {
      "name": "github-copilot-enterprise",
      "auth_files": [
        "auth.json"
      ],
      "auth_session": {
        "mode": "",
        "checks": [
          {
            "file": "auth.json",
            "type": "json_pointer_non_null",
            "pointer": "/github-copilot-enterprise"
          }
        ]
      }
    }
  ],
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      }
    },
    "chatgpt-oauth": {
      "env_vars": null,
      "release": {
        "http": {
          "hosts": [
            "chatgpt.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false
    },
    "copilot-oauth": {
      "env_vars": null,
      "release": {
        "http": {
          "hosts": [
            "*.githubcopilot.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false
    },
    "gemini-api-key": {
      "env_vars": [
        "GEMINI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "generativelanguage.googleapis.com"
          ],
          "header": "x-goog-api-key"
        }
      }
    },
    "openai-api-key": {
      "env_vars": [
        "OPENAI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.openai.com",
            "api.openai.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    }
  },
  "host_config_dir": "",
  "host_credentials_file": "",
  "host_oauth_json": ""
}
