{
  "name": "codex",
  "command": "codex",
  "continue_args": [
    "resume",
    "--last"
  ],
  "resume_args": [
    "resume"
  ],
  "yolo_flag": "--dangerously-bypass-approvals-and-sandbox",
  "yolo_enabled": true,
  "config_dir": ".codex",
  "skills_dir": ".codex/skills",
  "memory_dir": ".codex/memories",
  "memory_scope": "session",
  "no_memory_args": [
    "-c",
    "features.memories=false"
  ],
  "state_paths": [
    "memories/",
    "memories_*.sqlite*",
    "thread-writer-locks/",
    "state_*.sqlite*",
    "thread_history_*.sqlite*"
  ],
  "settings_file": "codex-config.toml",
  "settings_target": ".codex/config.toml",
  "passthrough_paths": [
    "config.toml",
    "skills/"
  ],
  "qemu_min_memory_mib": 4096,
  "qemu_store_cache_mmap": true,
  "providers": [
    {
      "name": "openai-codex",
      "credential_secrets": [
        "openai-api-key",
        "codex-access-token"
      ],
      "auth_files": [
        "auth.json"
      ],
      "auth_secrets": [
        {
          "file": "auth.json",
          "codec": "codex-auth",
          "fields": [
            {
              "pointer": "/OPENAI_API_KEY",
              "kind": "apiKey",
              "release": "openai-api-key"
            },
            {
              "pointer": "/tokens/access_token",
              "kind": "access",
              "release": "codex-access-token",
              "placeholder": {
                "shape": "jwt",
                "random": {
                  "encoding": "",
                  "length": 0
                }
              }
            },
            {
              "pointer": "/tokens/refresh_token",
              "kind": "refresh"
            },
            {
              "pointer": "/tokens/id_token",
              "kind": "id",
              "placeholder": {
                "shape": "jwt",
                "random": {
                  "encoding": "",
                  "length": 0
                }
              }
            }
          ]
        }
      ],
      "token_endpoint": {
        "host": "auth.openai.com",
        "path": "/oauth/token",
        "body": "either",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "fields": {
          "access": "access_token",
          "expiresIn": "expires_in",
          "id": "id_token",
          "refresh": "refresh_token",
          "scope": "scope"
        }
      },
      "auth_session": {
        "mode": "any",
        "checks": [
          {
            "file": "auth.json",
            "type": "file_exists"
          }
        ]
      },
      "oauth_ports": [
        {
          "port": "1455"
        }
      ]
    }
  ],
  "secrets": {
    "codex-access-token": {
      "env_vars": [
        "CODEX_ACCESS_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "auth.openai.com",
            "chatgpt.com"
          ],
          "header": "authorization",
          "format": "Bearer %s",
          "required_value_prefix": "at-"
        }
      },
      "api_key": false,
      "placeholder": {
        "prefix": "at-ENCLAVE_SECRET_",
        "random": {
          "encoding": "hex",
          "length": 48
        }
      }
    },
    "openai-api-key": {
      "env_vars": [
        "CODEX_API_KEY",
        "OPENAI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.openai.com",
            "api.openai.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    }
  },
  "host_config_dir": "",
  "host_credentials_file": "",
  "host_oauth_json": ""
}
