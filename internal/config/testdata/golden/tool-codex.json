{
  "name": "codex",
  "command": "codex",
  "continue_args": [
    "resume",
    "--last"
  ],
  "resume_args": [
    "resume"
  ],
  "yolo_flag": "--dangerously-bypass-approvals-and-sandbox",
  "yolo_enabled": true,
  "config_dir": ".codex",
  "skills_dir": ".codex/skills",
  "memory_dir": ".codex/memories",
  "memory_scope": "session",
  "no_memory_args": [
    "-c",
    "features.memories=false"
  ],
  "state_paths": [
    "memories/",
    "memories_*.sqlite*",
    "thread-writer-locks/",
    "state_*.sqlite*",
    "thread_history_*.sqlite*"
  ],
  "settings_file": "codex-config.toml",
  "settings_target": ".codex/config.toml",
  "passthrough_paths": [
    "config.toml",
    "skills/"
  ],
  "qemu_min_memory_mib": 4096,
  "qemu_store_cache_mmap": true,
  "providers": [
    {
      "name": "openai-codex",
      "credential_secrets": [
        "openai-api-key",
        "codex-access-token"
      ],
      "auth_files": [
        "auth.json"
      ],
      "auth_session": {
        "mode": "any",
        "checks": [
          {
            "file": "auth.json",
            "type": "file_exists"
          }
        ]
      },
      "oauth_ports": [
        {
          "port": "1455"
        }
      ]
    }
  ],
  "secrets": {
    "codex-access-token": {
      "env_vars": [
        "CODEX_ACCESS_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "auth.openai.com",
            "chatgpt.com"
          ],
          "header": "authorization",
          "format": "Bearer %s",
          "required_value_prefix": "at-"
        }
      },
      "api_key": false,
      "placeholder": {
        "prefix": "at-ENCLAVE_SECRET_",
        "random": {
          "encoding": "hex",
          "length": 48
        }
      }
    },
    "openai-api-key": {
      "env_vars": [
        "CODEX_API_KEY",
        "OPENAI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.openai.com",
            "api.openai.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    }
  },
  "host_config_dir": "",
  "host_credentials_file": "",
  "host_oauth_json": "",
  "a2a": {
    "command": [
      "codex",
      "exec",
      "--json",
      "-c",
      "features.daemon_auto_start=false",
      "-c",
      "features.memories=false"
    ],
    "resumeArgs": [
      "resume",
      "{sessionId}"
    ],
    "eventFormat": "codex-exec-json",
    "versionCommand": [
      "codex",
      "--version"
    ],
    "versions": "\u003e=0.166.0 \u003c0.167.0",
    "skills": [
      {
        "id": "coding",
        "name": "Coding",
        "description": "Reads, edits and tests code in the worker's project and answers with a summary of what it did.",
        "tags": [
          "code",
          "review",
          "refactor",
          "test"
        ]
      }
    ],
    "orchestratorArgs": [
      "-c",
      "features.daemon_auto_start=false",
      "-c",
      "mcp_servers.enclave-a2a.command=\"enclave-a2a-agent\"",
      "-c",
      "mcp_servers.enclave-a2a.args=[\"mcp\"]",
      "-c",
      "mcp_servers.enclave-a2a.tool_timeout_sec=150",
      "-c",
      "mcp_servers.enclave-a2a.env_vars=[\"ENCLAVE_A2A_ROLE\",\"ENCLAVE_A2A_GROUP\",\"ENCLAVE_A2A_GROUP_GENERATION\",\"ENCLAVE_A2A_MEMBER\",\"ENCLAVE_A2A_MEMBER_GENERATION\",\"ENCLAVE_A2A_HUB_HOST\",\"ENCLAVE_A2A_HUB_PORT\",\"ENCLAVE_A2A_INBOUND_TOKEN\",\"ENCLAVE_A2A_TABLE_DIR\",\"ENCLAVE_A2A_SEND_WAIT\",\"ENCLAVE_A2A_MAX_REQUEST_BYTES\",\"ENCLAVE_A2A_MAX_RESULT_BYTES\",\"ENCLAVE_A2A_RECORD_LIMIT\",\"ENCLAVE_A2A_RECORD_MAX_AGE\",\"ENCLAVE_A2A_RECONNECT_WINDOW\",\"ENCLAVE_A2A_CONTEXT_TTL\",\"ENCLAVE_A2A_TERMINATION_TIMEOUT\",\"ENCLAVE_A2A_HEARTBEAT_INTERVAL\"]"
    ]
  }
}
