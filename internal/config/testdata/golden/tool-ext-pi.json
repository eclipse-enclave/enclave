{
  "type": "sandbox",
  "name": "pi",
  "display_name": "Pi Coding Agent",
  "description": "A minimal terminal coding harness",
  "default_included": true,
  "priority": 100,
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      }
    },
    "anthropic-oauth-token": {
      "env_vars": [
        "ANTHROPIC_OAUTH_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.anthropic.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false,
      "placeholder": {
        "prefix": "sk-ant-oat01-ENCLAVE_SECRET_",
        "random": {
          "encoding": "hex",
          "length": 48
        }
      }
    },
    "gemini-api-key": {
      "env_vars": [
        "GEMINI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "generativelanguage.googleapis.com"
          ],
          "header": "x-goog-api-key"
        }
      }
    },
    "mistral-api-key": {
      "env_vars": [
        "MISTRAL_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.mistral.ai"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    },
    "openai-api-key": {
      "env_vars": [
        "OPENAI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.openai.com",
            "api.openai.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    }
  },
  "environment": {
    "PI_SKIP_VERSION_CHECK": "1",
    "PI_TELEMETRY": "0"
  }
}
