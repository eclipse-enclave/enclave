{
  "type": "sandbox",
  "name": "antigravity",
  "display_name": "Antigravity CLI",
  "description": "Google Antigravity CLI (agy)",
  "default_included": true,
  "priority": 100,
  "secrets": {
    "gemini-api-key": {
      "env_vars": [
        "GEMINI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "generativelanguage.googleapis.com"
          ],
          "header": "x-goog-api-key"
        }
      }
    }
  },
  "environment": {
    "AGY_CLI_DISABLE_AUTO_UPDATE": "true"
  }
}
