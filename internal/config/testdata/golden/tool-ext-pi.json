{
  "type": "sandbox",
  "name": "pi",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "default_included": true,
  "priority": 100,
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      }
    },
    "gemini-api-key": {
      "env_vars": [
        "GEMINI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "generativelanguage.googleapis.com"
          ],
          "header": "x-goog-api-key"
        }
      }
    },
    "mistral-api-key": {
      "env_vars": [
        "MISTRAL_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.mistral.ai"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    },
    "openai-api-key": {
      "env_vars": [
        "OPENAI_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.openai.com",
            "api.openai.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      }
    }
  },
  "environment": {
    "PI_SKIP_VERSION_CHECK": "1",
    "PI_TELEMETRY": "0"
  }
}
