{
  "name": "claude",
  "command": "claude",
  "continue_args": [
    "--continue"
  ],
  "resume_args": [
    "--resume"
  ],
  "yolo_flag": "--dangerously-skip-permissions",
  "yolo_enabled": true,
  "config_dir": ".claude",
  "skills_dir": ".claude/skills",
  "memory_dir": ".claude/memory",
  "memory_scope": "project",
  "no_memory_args": [
    "--settings",
    "{\"autoMemoryEnabled\": false}"
  ],
  "settings_file": "claude-settings.json",
  "settings_target": ".claude/settings.json",
  "passthrough_paths": [
    "agents/",
    "commands/",
    "settings.json",
    "skills/"
  ],
  "qemu_min_memory_mib": 4096,
  "providers": [
    {
      "name": "anthropic",
      "credential_secrets": [
        "anthropic-api-key",
        "claude-code-oauth-token"
      ],
      "auth_files": [
        "config.json",
        ".credentials.json"
      ],
      "auth_secrets": [
        {
          "file": ".credentials.json",
          "codec": "claude-credentials",
          "fields": [
            {
              "pointer": "/claudeAiOauth/accessToken",
              "kind": "access",
              "release": "claude-code-oauth-token",
              "placeholder": {
                "prefix": "sk-ant-oat01-",
                "random": {
                  "encoding": "base64url",
                  "length": 86
                }
              }
            },
            {
              "pointer": "/claudeAiOauth/refreshToken",
              "kind": "refresh",
              "placeholder": {
                "prefix": "sk-ant-ort01-",
                "random": {
                  "encoding": "base64url",
                  "length": 86
                }
              }
            }
          ]
        },
        {
          "file": "config.json",
          "codec": "claude-config",
          "fields": [
            {
              "pointer": "/primaryApiKey",
              "kind": "apiKey",
              "release": "anthropic-api-key"
            },
            {
              "pointer": "/anthropicApiKey",
              "kind": "apiKey",
              "release": "anthropic-api-key"
            }
          ]
        },
        {
          "checkOnly": true,
          "file": ".claude.json",
          "codec": "claude-config",
          "fields": [
            {
              "pointer": "/primaryApiKey",
              "kind": "apiKey",
              "release": "anthropic-api-key"
            },
            {
              "pointer": "/anthropicApiKey",
              "kind": "apiKey",
              "release": "anthropic-api-key"
            }
          ]
        }
      ],
      "token_endpoint": {
        "host": "platform.claude.com",
        "path": "/v1/oauth/token",
        "body": "json",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "fields": {
          "access": "access_token",
          "expiresIn": "expires_in",
          "refresh": "refresh_token",
          "scope": "scope"
        },
        "deny": [
          {
            "host": "api.anthropic.com",
            "path": "/api/oauth/claude_cli/create_api_key"
          },
          {
            "host": "api.anthropic.com",
            "path": "/api/oauth/claude_cli/client_data"
          },
          {
            "host": "platform.claude.com",
            "path": "/v1/oauth/revoke"
          }
        ]
      },
      "auth_session": {
        "mode": "any",
        "checks": [
          {
            "file": "config.json",
            "type": "file_exists"
          },
          {
            "file": ".credentials.json",
            "type": "file_exists"
          }
        ]
      },
      "securestorage_dir_env": "CLAUDE_SECURESTORAGE_CONFIG_DIR"
    }
  ],
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      }
    },
    "claude-code-oauth-token": {
      "env_vars": [
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.anthropic.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false
    }
  },
  "host_config_dir": ".claude",
  "host_credentials_file": ".credentials.json",
  "host_oauth_json": ".claude.json"
}
