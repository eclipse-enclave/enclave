{
  "type": "sandbox",
  "name": "claude",
  "display_name": "Claude Code",
  "description": "Claude Code AI assistant",
  "default_included": true,
  "priority": 100,
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      },
      "placeholder": {
        "prefix": "sk-ant-api03-",
        "suffix": "AA",
        "random": {
          "encoding": "base64url",
          "length": 93
        }
      }
    },
    "claude-code-oauth-token": {
      "env_vars": [
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.anthropic.com",
            "mcp-proxy.anthropic.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false,
      "placeholder": {
        "prefix": "sk-ant-oat01-",
        "suffix": "AA",
        "random": {
          "encoding": "base64url",
          "length": 93
        }
      }
    }
  }
}
