{
  "name": "claude",
  "command": "claude",
  "continue_args": [
    "--continue"
  ],
  "resume_args": [
    "--resume"
  ],
  "yolo_flag": "--dangerously-skip-permissions",
  "yolo_enabled": true,
  "config_dir": ".claude",
  "skills_dir": ".claude/skills",
  "memory_dir": ".claude/memory",
  "memory_scope": "project",
  "no_memory_args": [
    "--settings",
    "{\"autoMemoryEnabled\": false}"
  ],
  "settings_file": "claude-settings.json",
  "settings_target": ".claude/settings.json",
  "passthrough_paths": [
    "agents/",
    "commands/",
    "settings.json",
    "skills/"
  ],
  "qemu_min_memory_mib": 4096,
  "providers": [
    {
      "name": "anthropic",
      "credential_secrets": [
        "anthropic-api-key",
        "claude-code-oauth-token"
      ],
      "auth_files": [
        "config.json",
        ".credentials.json"
      ],
      "auth_session": {
        "mode": "any",
        "checks": [
          {
            "file": "config.json",
            "type": "file_exists"
          },
          {
            "file": ".credentials.json",
            "type": "file_exists"
          }
        ]
      },
      "securestorage_dir_env": "CLAUDE_SECURESTORAGE_CONFIG_DIR"
    }
  ],
  "secrets": {
    "anthropic-api-key": {
      "env_vars": [
        "ANTHROPIC_API_KEY"
      ],
      "release": {
        "http": {
          "hosts": [
            "*.anthropic.com",
            "api.anthropic.com"
          ],
          "header": "x-api-key"
        }
      }
    },
    "claude-code-oauth-token": {
      "env_vars": [
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "release": {
        "http": {
          "hosts": [
            "api.anthropic.com"
          ],
          "header": "authorization",
          "format": "Bearer %s"
        }
      },
      "api_key": false
    }
  },
  "host_config_dir": ".claude",
  "host_credentials_file": ".credentials.json",
  "host_oauth_json": ".claude.json",
  "a2a": {
    "command": [
      "claude",
      "-p",
      "--output-format",
      "stream-json",
      "--verbose"
    ],
    "newSessionArgs": [
      "--session-id",
      "{sessionId}"
    ],
    "resumeArgs": [
      "--resume",
      "{sessionId}"
    ],
    "eventFormat": "claude-stream-json",
    "versionCommand": [
      "claude",
      "--version"
    ],
    "versions": "\u003e=2.1.306 \u003c3.0.0",
    "skills": [
      {
        "id": "coding",
        "name": "Coding",
        "description": "Reads, edits and tests code in the worker's project and answers with a summary of what it did.",
        "tags": [
          "code",
          "review",
          "refactor",
          "test"
        ]
      }
    ],
    "orchestratorArgs": [
      "--mcp-config",
      "/usr/local/share/enclave/templates/claude-a2a-mcp.json"
    ]
  }
}
